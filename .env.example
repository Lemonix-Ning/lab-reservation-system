# 数据库配置
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/lab_reservation_db"

# 会话加密密钥（用 openssl rand -hex 32 生成）
JWT_SECRET="256ec08ba53dbb44e95050cb5d00883f3f6dd2cb14a4103d24fb7f0f66bae7ef"

# OAuth 配置
OAUTH_SERVER_URL="http://localhost:4000"
OAUTH_CLIENT_ID="local-client-id"
OAUTH_CLIENT_SECRET="your-client-secret-here"
MOCK_OAUTH_ENABLED="true"

# 讯飞星火 AI 配置
# 从 https://console.xfyun.cn/services/cbm 获取 APIPassword
XFYUN_API_PASSWORD="your_appid:your_apisecret"
XFYUN_MODEL="4.0Ultra"

# =============================================
# 实验室预约系统 - 生产环境变量配置
# 复制本文件为 .env 并填写真实值
# =============================================

# ─── 数据库配置 ──────────────────────────────
# Docker Compose 中 MySQL 的 root 密码（仅容器内部使用）
DB_ROOT_PASSWORD=your_strong_root_password_here

# 应用连接数据库使用的账号（非 root）
DB_USER=lab_user
DB_PASSWORD=your_db_password_here

# ─── 应用安全配置 ────────────────────────────
# JWT 签名密钥，建议 64 位以上随机字符串
# 生成命令：openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here_at_least_32_chars

# 系统初始管理员的 OpenID（用系统 OAuth 登录后从日志里取）
OWNER_OPEN_ID=your_owner_openid_here

# ─── GitHub OAuth ────────────────────────────
# 在 https://github.com/settings/developers 创建 OAuth App
# Authorization callback URL: https://lemonix.loc.cc/api/oauth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ─── QQ OAuth（可选）── ────────────────────────
# 在 https://connect.qq.com/manage.html 创建应用
# 回调地址: https://lemonix.loc.cc/api/oauth/qq/callback
QQ_APP_ID=
QQ_APP_KEY=

# ─── 讯飞星火 AI（可选）─────────────────────
# 在 https://console.xfyun.cn/app/myapp 获取
XFYUN_API_PASSWORD=
XFYUN_MODEL=spark-lite
